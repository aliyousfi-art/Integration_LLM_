{
  "name": "form_db_client",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Comparateur LLM - Avec sauvegarde",
        "formDescription": "Chaque comparaison est enregistrée en base de données pour analyse.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Votre question",
              "fieldType": "textarea",
              "fieldId": "question",
              "requiredField": true,
              "placeholder": "Posez votre question aux modèles LLM"
            },
            {
              "fieldLabel": "Température",
              "fieldType": "number",
              "fieldId": "temperature",
              "requiredField": false,
              "defaultValue": "0.7"
            },
            {
              "fieldLabel": "Max tokens",
              "fieldType": "number",
              "fieldId": "max_tokens",
              "requiredField": false,
              "defaultValue": "500"
            }
          ]
        },
        "options": {
          "buttonLabel": "Comparer et sauvegarder",
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "responseText": "✅ Comparaison enregistrée en base de données !"
            }
          }
        }
      },
      "id": "d1e2f3a4-b5c6-4d7e-8f9a-0b1c2d3e4f5a",
      "name": "Form Trigger",
      "type": "n8n-nodes-base.formTrigger",
      "position": [200, 500],
      "webhookId": "form-db-client-001",
      "typeVersion": 2.2
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "question",
        "columns": "question,temperature,max_tokens",
        "additionalFields": {
          "returnFields": "id"
        }
      },
      "id": "e3f4a5b6-c7d8-4e9f-0a1b-2c3d4e5f6a7b",
      "name": "Save Question to DB",
      "type": "n8n-nodes-base.postgres",
      "position": [460, 500],
      "typeVersion": 2.4,
      "credentials": {
        "postgres": {
          "id": "PostgresCred001",
          "name": "PostgreSQL - Comparateur LLM"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const dbResult = $input.first().json;\nconst formData = $('Form Trigger').first().json;\n\nconst questionId = dbResult.id;\n\nconst payload = {\n  chatInput: formData.question,\n  temperature: parseFloat(formData.temperature) || 0.7,\n  max_tokens: parseInt(formData.max_tokens) || 500,\n  question_id: questionId\n};\n\nreturn [{ json: payload }];"
      },
      "id": "f5a6b7c8-d9e0-4f1a-2b3c-4d5e6f7a8b9c",
      "name": "Prepare Payload with ID",
      "type": "n8n-nodes-base.code",
      "position": [720, 500],
      "typeVersion": 2
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/ollama",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chatInput\": \"{{ $json.chatInput }}\",\n  \"temperature\": {{ $json.temperature }},\n  \"question_id\": {{ $json.question_id }}\n}",
        "options": { "timeout": 90000 }
      },
