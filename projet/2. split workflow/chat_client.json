      "parameters": {
        "jsCode": "const responses = $input.all();\nconst models = ['Ollama (Mistral)', 'Google Gemini', 'Mistral AI', 'OpenAI GPT-3.5'];\n\nlet combined = '📊 **Comparaison des modèles LLM**\\n\\n';\n\nresponses.forEach((item, i) => {\n  const modelName = models[i] || `Modèle ${i + 1}`;\n  const text = item.json?.text || item.json?.output || item.json?.response || 'Pas de réponse';\n  combined += `🤖 **${modelName}**:\\n${text}\\n\\n---\\n\\n`;\n});\n\nreturn [{ json: { combined, count: responses.length } }];"
