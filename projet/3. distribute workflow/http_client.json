    {
      "parameters": {
        "jsCode": "const responses = $input.all();\nconst models = ['Ollama (Mistral)', 'Google Gemini', 'Mistral AI', 'OpenAI GPT-3.5'];\n\nlet combined = '📊 **Comparaison via webhooks HTTP**\\n\\n';\n\nresponses.forEach((item, i) => {\n  const modelName = models[i] || `Modèle ${i + 1}`;\n  const text = item.json?.text || item.json?.output || item.json?.response || JSON.stringify(item.json);\n  combined += `🤖 **${modelName}**:\\n${text}\\n\\n---\\n\\n`;\n});\n\nreturn [{ json: { combined } }];"
      },
      "id": "f4a5b6c7-d8e9-4f0a-1b2c-3d4e5f6a7b8c",
