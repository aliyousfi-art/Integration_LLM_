{
  "name": "form_client",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Comparateur de LLM",
        "formDescription": "Comparez les réponses de différents modèles de langage sur la même question.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Votre question",
              "fieldType": "textarea",
              "fieldId": "question",
              "requiredField": true,
              "placeholder": "Ex: Explique-moi l'intelligence artificielle en termes simples"
            },
            {
              "fieldLabel": "Température (créativité : 0 = factuel, 2 = créatif)",
              "fieldType": "number",
              "fieldId": "temperature",
              "requiredField": false,
              "defaultValue": "0.7"
            },
            {
              "fieldLabel": "Longueur max réponse (tokens)",
              "fieldType": "number",
              "fieldId": "max_tokens",
              "requiredField": false,
              "defaultValue": "500"
            },
            {
              "fieldLabel": "Instructions système (optionnel)",
              "fieldType": "textarea",
              "fieldId": "system_prompt",
              "requiredField": false,
              "placeholder": "Ex: Tu es un expert en pédagogie, explique de manière simple et illustrée."
            }
          ]
        },
        "options": {
          "buttonLabel": "Comparer les modèles",
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "responseText": "✅ Comparaison terminée ! Résultats disponibles."
            }
          }
        }
      },
      "id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
      "name": "Form Trigger",
      "type": "n8n-nodes-base.formTrigger",
      "position": [200, 500],
      "webhookId": "form-client-001",
      "typeVersion": 2.2
    },
    {
      "parameters": {
        "jsCode": "const formData = $input.first().json;\n\nconst payload = {\n  chatInput: formData.question,\n  temperature: parseFloat(formData.temperature) || 0.7,\n  max_tokens: parseInt(formData.max_tokens) || 500\n};\n\nif (formData.system_prompt && formData.system_prompt.trim()) {\n  payload.system_prompt = formData.system_prompt.trim();\n}\n\nreturn [{ json: payload }];"
      },
      "id": "b3c4d5e6-f7a8-4b9c-0d1e-2f3a4b5c6d7e",
      "name": "Prepare Payload",
      "type": "n8n-nodes-base.code",
      "position": [460, 500],
      "typeVersion": 2
    },
    {
