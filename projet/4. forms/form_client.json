    {
      "parameters": {
        "jsCode": "const responses = $input.all();\nconst models = ['Ollama (Mistral local)', 'Google Gemini Pro', 'Mistral AI Small', 'OpenAI GPT-3.5'];\n\nconst results = responses.map((item, i) => ({\n  model: models[i] || `Modèle ${i+1}`,\n  response: item.json?.text || item.json?.output || item.json?.response || 'Pas de réponse'\n}));\n\nreturn [{ json: { results, total: results.length } }];"
      },
