# ====================================
# FICHIER DE CONFIGURATION ENVIRONNEMENT
# ====================================
# Ce fichier contient toutes les variables d'environnement nécessaires
# pour configurer votre stack n8n + PostgreSQL + pgAdmin + Ollama
#
# INSTRUCTIONS :
# 1. Copiez ce fichier en .env (cp .env.example .env)
# 2. Remplacez les valeurs par défaut par vos propres valeurs sécurisées
# 3. NE COMMITEZ JAMAIS le fichier .env sur Git !
# ====================================

# ====================================
# N8N - Plateforme d'automatisation
# ====================================

# Authentification basique n8n
# Utilisateur pour se connecter à l'interface n8n (http://localhost:5678)
N8N_BASIC_AUTH_USER=admin

# Mot de passe pour l'interface n8n
# ⚠️ IMPORTANT : Changez cette valeur pour un mot de passe fort !
# Recommandation : Au moins 12 caractères, avec majuscules, minuscules, chiffres et symboles
N8N_BASIC_AUTH_PASSWORD=strong_password_here

# Active l'authentification basique (true/false)
N8N_BASIC_AUTH_ACTIVE=true

# URL du webhook pour n8n (laisser par défaut en local)
# Si vous exposez n8n sur un réseau, changez localhost par votre IP/domaine
N8N_WEBHOOK_URL=http://localhost:5678

# Timezone pour n8n (optionnel)
# Exemples : Europe/Paris, America/New_York, Asia/Tokyo
GENERIC_TIMEZONE=Europe/Paris

# ====================================
# POSTGRESQL - Base de données
# ====================================

# Type de base de données utilisée par n8n
DB_TYPE=postgresdb

# Hôte PostgreSQL (nom du service Docker, ne pas changer)
DB_POSTGRESDB_HOST=postgres

# Port PostgreSQL interne au conteneur (ne pas changer)
DB_POSTGRESDB_PORT=5432

# Nom de la base de données n8n
DB_POSTGRESDB_DATABASE=n8n

# Utilisateur PostgreSQL pour n8n
DB_POSTGRESDB_USER=n8n_user

# Mot de passe PostgreSQL pour n8n
# ⚠️ IMPORTANT : Changez cette valeur !
# Cette valeur doit être identique à POSTGRES_PASSWORD
DB_POSTGRESDB_PASSWORD=strong_db_password_here

# Configuration PostgreSQL principale
# Utilisateur par défaut de PostgreSQL
POSTGRES_USER=n8n_user

# Mot de passe PostgreSQL (doit être identique à DB_POSTGRESDB_PASSWORD)
# ⚠️ IMPORTANT : Changez cette valeur !
POSTGRES_PASSWORD=strong_db_password_here

# Base de données par défaut
POSTGRES_DB=n8n

# ====================================
# PGADMIN - Interface de gestion PostgreSQL
# ====================================

# Email de connexion à pgAdmin (http://localhost:5050)
# Vous pouvez personnaliser avec votre propre email
PGADMIN_DEFAULT_EMAIL=admin@admin.com

# Mot de passe pour pgAdmin
# ⚠️ IMPORTANT : Changez cette valeur !
PGADMIN_DEFAULT_PASSWORD=strong_pgadmin_password_here

# ====================================
# OLLAMA - Serveur de modèles LLM locaux
# ====================================

# URL du serveur Ollama (pour connexion depuis n8n)
# En Docker, utilisez le nom du service : http://ollama:11434
OLLAMA_HOST=http://ollama:11434

# Modèles à télécharger automatiquement (optionnel)
# Exemples : mistral, llama2, codellama, gemma
# Séparez par des virgules : OLLAMA_MODELS=mistral,llama2
OLLAMA_MODELS=mistral

# ====================================
# CONFIGURATION RÉSEAU
# ====================================

# Port externe pour n8n (accessible sur http://localhost:PORT)
# Changez si le port 5678 est déjà utilisé sur votre machine
N8N_PORT=5678

# Port externe pour PostgreSQL
# Changez si le port 5434 est déjà utilisé
# Note : Port non-standard (5434 au lieu de 5432) pour éviter les conflits
POSTGRES_PORT=5434

# Port externe pour pgAdmin
# Changez si le port 5050 est déjà utilisé
PGADMIN_PORT=5050

# Port externe pour Ollama
# Changez si le port 11434 est déjà utilisé
OLLAMA_PORT=11434

# ====================================
# SÉCURITÉ - RECOMMANDATIONS
# ====================================

# 🔐 Génération de mots de passe sécurisés :
#
# Sous Linux/Mac :
#   openssl rand -base64 32
#
# Sous Windows PowerShell :
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | % {[char]$_})
#
# En ligne (à utiliser avec précaution) :
#   https://passwordsgenerator.net/
#
# 📋 Checklist de sécurité :
# [ ] Tous les mots de passe ont été changés
# [ ] Le fichier .env n'est PAS dans Git (.gitignore)
# [ ] Les mots de passe sont différents pour chaque service
# [ ] Les mots de passe font au moins 16 caractères
# [ ] Backup régulier de la base de données configuré
#
# ⚠️ ATTENTION :
# - Ne partagez JAMAIS ce fichier .env
# - Ne le commitez JAMAIS sur Git
# - Faites des backups chiffrés de vos mots de passe
# ====================================